# =============================================================================
# Scrappy -- configuracion de ejemplo
#
# Copia este fichero a `.env` y rellena los valores. `.env` esta en .gitignore
# y nunca debe subirse al repositorio.
#
# La referencia completa de cada variable esta en docs/CONFIGURATION.md
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram  (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Token que te da @BotFather al crear el bot con /newbot
SCRAPPY_TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Chat, grupo o canal donde se publica el contenido.
# Como obtenerlo: anade el bot al canal como administrador y reenvia
# cualquier mensaje del canal a @userinfobot, o usa `scrappy whoami`.
# Los canales y supergrupos tienen IDs negativos (-100...).
SCRAPPY_TELEGRAM_TARGET_CHAT_ID=-1001234567890

# IDs de usuario autorizados a usar los comandos del bot, separados por coma.
# Si se deja vacio, NADIE puede ejecutar comandos (el scheduler sigue activo).
SCRAPPY_TELEGRAM_ADMIN_IDS=987654321

# -----------------------------------------------------------------------------
# Almacenamiento  (ver docs/EPHEMERAL_STORAGE.md)
# -----------------------------------------------------------------------------
# El contenido NUNCA se conserva. Esto solo controla los metadatos de dedup.
#   sqlite  -> ~200 bytes por item en data/scrappy.db. Evita repetidos entre runs.
#   memory  -> nada toca el disco; el bot puede repetir contenido entre runs.
#   none    -> sin dedup en absoluto.
SCRAPPY_STATE_BACKEND=sqlite
SCRAPPY_STATE_DB_PATH=data/scrappy.db

# Directorio raiz de los workspaces efimeros. En Docker es un tmpfs (RAM).
# Si se deja vacio se usa el directorio temporal del sistema.
SCRAPPY_WORKSPACE_ROOT=

# Aborta la descarga si el medio supera este tamano (MB).
SCRAPPY_MAX_DOWNLOAD_MB=60

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
SCRAPPY_SCHEDULE_ENABLED=true
# Cada cuantos minutos se ejecuta el pipeline automaticamente.
SCRAPPY_SCHEDULE_INTERVAL_MINUTES=180
# Cuantos items se publican como maximo en cada ejecucion.
SCRAPPY_ITEMS_PER_RUN=5

# -----------------------------------------------------------------------------
# Reddit  (fuente recomendada -- NO necesita credenciales)
#
# Scrappy usa los feeds Atom publicos, no la API. Motivo: el registro de apps
# se cerro en noviembre de 2025 y los endpoints .json devuelven 403 desde mayo
# de 2026. Los feeds siguen abiertos y no piden autenticacion.
#
# Lo unico obligatorio es identificarte en el User-Agent: con uno generico
# Reddit responde 429. Pon tu usuario real de Reddit.
# -----------------------------------------------------------------------------
SCRAPPY_REDDIT_ENABLED=true
SCRAPPY_REDDIT_USER_AGENT=windows:scrappy:0.1.0 (by /u/tu_usuario)

# -----------------------------------------------------------------------------
# Lemmy  (la alternativa federada a Reddit -- TAMPOCO necesita credenciales)
#
# Su API es publica y sin autenticacion porque la lectura anonima es un
# requisito de la federacion. No hay clave que pedir ni cuota que agotar.
# La instancia y las comunidades se configuran en config/sources.yaml
# -----------------------------------------------------------------------------
SCRAPPY_LEMMY_ENABLED=true

# -----------------------------------------------------------------------------
# Bluesky  (TAMPOCO necesita credenciales)
#
# Su AppView publico responde sin autenticacion. Es la fuente pensada para
# pillar lo que empieza a moverse antes de llegar a las redes grandes.
# Las consultas se configuran en config/sources.yaml
# -----------------------------------------------------------------------------
SCRAPPY_BLUESKY_ENABLED=true

# -----------------------------------------------------------------------------
# Imgur  (clave gratuita, registro instantaneo)
#
# Imgur mantiene el registro autoservicio que Reddit cerro: saca tu Client-ID
# en https://api.imgur.com/oauth2/addclient -- elige "Anonymous usage without
# user authorization". Da unas 12.500 peticiones al dia.
# El Client Secret NO hace falta.
# -----------------------------------------------------------------------------
SCRAPPY_IMGUR_ENABLED=false
SCRAPPY_IMGUR_CLIENT_ID=

# -----------------------------------------------------------------------------
# Giphy  (clave beta gratuita, registro instantaneo)
#
# Crea una cuenta en https://developers.giphy.com y pulsa "Create an API Key".
# La clave beta da 100 llamadas por hora, que para publicar cada tres horas
# sobra de largo.
#
# OJO: Giphy no expone ningun contador de popularidad, asi que el ranking usa
# la posicion en `trending`, que ya es un ranking hecho por ellos.
# -----------------------------------------------------------------------------
SCRAPPY_GIPHY_ENABLED=false
SCRAPPY_GIPHY_API_KEY=

# -----------------------------------------------------------------------------
# Fuentes con riesgo de ToS  (ver docs/LEGAL.md ANTES de activar)
#
# X-scrape, TikTok e Instagram no tienen API publica para este caso de uso.
# Usarlas incumple los terminos de servicio de esas plataformas y el
# contenido pertenece a sus autores. Este flag debe ponerse a `true`
# explicitamente; es tu decision y tu responsabilidad.
# -----------------------------------------------------------------------------
SCRAPPY_ENABLE_TOS_RISKY_SOURCES=false

# --- X / Twitter -------------------------------------------------------------
SCRAPPY_X_ENABLED=false
# Backend: `api` (oficial) o `scrape` (yt-dlp, requiere el flag de arriba).
#
# ATENCION: el tier gratuito de la API de X NO permite buscar posts.
# El endpoint de busqueda necesita el tier Basic (~200 USD/mes).
# Si no lo tienes, usa el backend `scrape` asumiendo sus riesgos.
SCRAPPY_X_BACKEND=api
SCRAPPY_X_BEARER_TOKEN=
# Fichero de cookies en formato Netscape, solo para el backend `scrape`.
SCRAPPY_X_COOKIES_FILE=

# --- YouTube Shorts ----------------------------------------------------------
# No pide clave ni cookies, pero descargar de YouTube tambien incumple sus
# terminos, asi que va detras del mismo flag por coherencia. El riesgo practico
# es menor que el de TikTok o Instagram: no hay cuenta tuya que puedan limitar.
SCRAPPY_YOUTUBE_ENABLED=false

# --- TikTok ------------------------------------------------------------------
SCRAPPY_TIKTOK_ENABLED=false
SCRAPPY_TIKTOK_COOKIES_FILE=

# --- Instagram ---------------------------------------------------------------
SCRAPPY_INSTAGRAM_ENABLED=false
# Instagram exige cookies de una sesion iniciada para casi todo.
SCRAPPY_INSTAGRAM_COOKIES_FILE=

# -----------------------------------------------------------------------------
# Contenido y filtros
# -----------------------------------------------------------------------------
SCRAPPY_ALLOW_NSFW=false
SCRAPPY_MIN_DURATION_SECONDS=1
SCRAPPY_MAX_DURATION_SECONDS=180
SCRAPPY_MAX_AGE_HOURS=48
# Umbral de distancia de Hamming del pHash para considerar dos medios iguales.
SCRAPPY_PHASH_THRESHOLD=6

# -----------------------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
SCRAPPY_LOG_LEVEL=INFO
# `console` para desarrollo (coloreado), `json` para produccion.
SCRAPPY_LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Rutas
# -----------------------------------------------------------------------------
SCRAPPY_SOURCES_CONFIG_PATH=config/sources.yaml
