/* Estilos de la TUI de Scrappy.
 *
 * Paleta sobria a proposito: la informacion que importa son los scores y el
 * estado de las fuentes, y un fondo llamativo solo compite con ellos.
 */

Screen {
    background: $surface;
}

#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* --------------------------------------------------------------------------
 * Panel
 * ------------------------------------------------------------------------ */
/* `height: auto` y no el `1fr` que trae `Vertical` por defecto: con 1fr, las
 * seis secciones del panel se reparten el alto disponible y cada una recorta
 * lo que no cabe. En una terminal de 30 filas eso dejaba «proxima ronda»
 * fuera de pantalla, sin ninguna senal de que faltara algo.
 *
 * Con auto, cada seccion ocupa lo que necesita y es el VerticalScroll de
 * fuera el que hace scroll, que es para lo que esta. */
.seccion {
    border: round $primary;
    padding: 0 1;
    margin: 0 1 1 1;
    height: auto;
}

.seccion-titulo {
    text-style: bold;
    color: $accent;
}

#salud-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 24 1fr;
    height: auto;
}

.ok {
    color: $success;
}

.aviso {
    color: $warning;
}

.error {
    color: $error;
}

#acciones-scheduler,
#acciones-config,
#acciones-autoarranque {
    height: auto;
    padding: 1 0;
}

#acciones-scheduler Button,
#acciones-config Button,
#acciones-autoarranque Button {
    margin: 0 1 0 0;
}

/* --------------------------------------------------------------------------
 * Candidatos
 * ------------------------------------------------------------------------ */
#candidatos-layout {
    layout: horizontal;
    height: 1fr;
}

#tabla-candidatos {
    width: 2fr;
    height: 1fr;
}

#desglose {
    width: 1fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
    overflow-y: auto;
}

#barra-progreso {
    height: auto;
    padding: 0 1;
}

/* --------------------------------------------------------------------------
 * Configuracion
 * ------------------------------------------------------------------------ */
#config-scroll {
    height: 1fr;
}

.campo-bloque {
    height: auto;
    padding: 0 1;
}

.campo {
    layout: horizontal;
    height: auto;
    padding: 0 0 1 0;
}

.campo Switch {
    margin: 0 1 0 0;
}

.campo Select {
    width: 1fr;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 0;
}

.campo-etiqueta {
    width: 28;
    padding: 1 1 0 0;
    color: $text-muted;
}

.campo Input {
    width: 1fr;
}

.ayuda {
    color: $text-muted;
    padding: 0 0 1 0;
}

/* --------------------------------------------------------------------------
 * Modal de confirmacion
 * ------------------------------------------------------------------------ */
WizardScreen {
    align: center middle;
}

#wizard-caja {
    width: 80;
    height: auto;
    max-height: 80%;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

#wizard-titulo {
    text-style: bold;
    color: $warning;
    padding: 0 0 1 0;
}

#wizard-botones {
    height: auto;
    align: right middle;
    padding: 1 0 0 0;
}

#wizard-botones Button {
    margin: 0 0 0 1;
}

HelpScreen {
    align: center middle;
}

#ayuda-caja {
    width: 84;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ConfirmModal {
    align: center middle;
}

#confirm-caja {
    width: 72;
    height: auto;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

#confirm-titulo {
    text-style: bold;
    color: $warning;
    padding: 0 0 1 0;
}

#confirm-detalle {
    padding: 0 0 1 0;
}

#confirm-botones {
    height: auto;
    align: right middle;
}

#confirm-botones Button {
    margin: 0 0 0 1;
}
