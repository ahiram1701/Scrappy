# Normaliza finales de linea para que el repo sea identico en Windows y Linux.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

*.png binary
*.jpg binary
*.svg text eol=lf

# Excluye ficheros de soporte del tarball de GitHub.
.github/     export-ignore
tests/       export-ignore
.editorconfig export-ignore
